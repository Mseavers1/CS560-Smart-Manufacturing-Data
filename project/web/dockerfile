FROM node:20-alpine AS builder
WORKDIR /app
ARG HOST_IP
ARG FASTAPI_PORT
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_AI_URL
ARG VITE_TWINS_URL
ARG VITE_ROBOT_CAMERA_URL
ARG VITE_DB_GUI_URL
ENV HOST_IP=$HOST_IP
ENV FASTAPI_PORT=$FASTAPI_PORT
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_AI_URL=$VITE_AI_URL
ENV VITE_TWINS_URL=$VITE_TWINS_URL
ENV VITE_ROBOT_CAMERA_URL=$VITE_ROBOT_CAMERA_URL
ENV VITE_DB_GUI_URL=$VITE_DB_GUI_URL
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
